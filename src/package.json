{
  "name": "databim.tech",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "python:vendor": "node scripts/vendor-python.mjs",
    "predev": "npm run python:vendor",
    "dev": "vite --host 0.0.0.0 --port 5175",
    "prebuild": "npm run python:vendor",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5175",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "tsc --noEmit -p tsconfig.tests.json && vitest run",
    "test:e2e": "playwright test",
    "check:arch": "depcruise infobim --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dockview": "8.3.1",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.4.17",
    "dwgdxf": "^2.0.1",
    "dxf-viewer": "^1.0.49",
    "heic-to": "^1.6.6",
    "marked": "^18.1.1",
    "n3": "^2.13.12",
    "read-excel-file": "^9.3.12",
    "three": "^0.186.1",
    "web-ifc": "^0.0.78",
    "xstate": "^5.33.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/n3": "^1.26.4",
    "@types/node": "22.20.4",
    "@types/three": "^0.186.0",
    "dependency-cruiser": "18.6.0",
    "pyodide": "0.28.3",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
